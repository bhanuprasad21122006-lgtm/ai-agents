# Add your keys here but do not commit this file to GitHub!
GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_MCP=0
MAX_PIPELINE_ATTEMPTS=2
PIPELINE_TIMEOUT_SECONDS=900

# Model Selection: 'auto' (default: automatically queries Gemini API to pick the best available model) or a specific model name (e.g. gemini-2.0-flash)
GEMINI_MODEL=auto

# MCP_SERVER_URL=http://localhost:8000
